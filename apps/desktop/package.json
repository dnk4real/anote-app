{
  "name": "@anote/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop shell for the Anote desktop client.",
  "author": "Chigu",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:shell": "wait-on tcp:4173 && electron .",
    "dev:electron": "concurrently -k \"npm:dev:web\" \"npm:dev:shell\"",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "package:win": "npm run build:web && electron-builder --win nsis --config.directories.output=artifacts-win",
    "package:dir": "npm run build:web && electron-builder --dir --config.directories.output=artifacts-dir"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@mdi/js": "^7.4.47",
    "@primer/octicons-react": "^19.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.anote.desktop",
    "productName": "Anote",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "anote-desktop-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
